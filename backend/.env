# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/mining_erp_db?schema=public"

# ---- JWT Secrets (Random Security Keys Added) ----
JWT_ACCESS_SECRET=mining_erp_dev_access_secret_key_987654321_super_secure
JWT_REFRESH_SECRET=mining_erp_dev_refresh_secret_key_123456789_super_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000

# ---- CORS / Cookies ----
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- File uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- Security ----
BCRYPT_SALT_ROUNDS=10

# ---- Initial Super Admin (used only by prisma/seed.js) ----
SUPER_ADMIN_EMAIL=admin@miningerp.com
SUPER_ADMIN_PASSWORD=Admin@12345